# ============================ SEARCH ============================
# serpapi.com - Google Lens + Yandex + Google reverse image + name search (free tier: 250 searches/month)
SERPAPI_KEY=
# optional: Google Cloud Vision Web Detection (API key with the Vision API enabled)
GOOGLE_VISION_API_KEY=
# optional alternative to the API key: path to a service-account JSON (needs `pip install google-auth`)
GOOGLE_APPLICATION_CREDENTIALS=
ENABLE_YANDEX=true
ENABLE_GOOGLE_REVERSE=true
ENABLE_BLUESKY=true
ENABLE_NAME_EXPANSION=true
# temporary public host for the query face crop (1 h TTL), needed by Yandex / Google reverse: auto|litterbox|tmpfiles|0x0|pinata|none
IMAGE_HOST=auto
SEARCH_COUNTRY=in
SEARCH_LANG=en
MAX_CANDIDATES=60
# ArcFace cosine similarity required to call a candidate "the same person"
MATCH_THRESHOLD=0.40

# ============================ STORAGE ============================
# optional: pin the evidence bundle to IPFS via Pinata (JWT)
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# ============================ BLOCKCHAIN (Ethereum Sepolia) ============================
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RPC_FALLBACKS=https://sepolia.drpc.org,https://rpc.sepolia.org,https://1rpc.io/sepolia
CHAIN_ID=11155111
CHAIN_NAME=Ethereum Sepolia
EXPLORER_URL=https://sepolia.etherscan.io
# testnet-only throwaway key: python -m verified.cli wallet new
PRIVATE_KEY=
# filled automatically by `python -m verified.cli deploy` (or on the first anchor)
CONTRACT_ADDRESS=
# per-install HMAC salt for face commitments; generated automatically on first run
COMMITMENT_SALT=
# also publish an Ethereum Attestation Service attestation
ENABLE_EAS=true
EAS_CONTRACT=0xC2679fBD37d54388Ce493F1DB75320D236e1815e
EAS_SCHEMA_REGISTRY=0x0a7E2Ff54e76B8E6659aedc9103FB21c038050D0
EAS_EXPLORER=https://sepolia.easscan.org
# also anchor into Bitcoin via OpenTimestamps (free, keyless)
ENABLE_OTS=true

# ============================ SERVER ============================
HOST=127.0.0.1
PORT=8000
